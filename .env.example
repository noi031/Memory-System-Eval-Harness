# EchoMem HTTP service used by all static benchmarks.
ECHOMEM_BASE_URL=http://127.0.0.1:8010
# For reuse-only LoCoMo QA, this must be the existing memory workspace,
# not a new or empty directory.
ECHOMEM_WORKSPACE=/absolute/path/to/existing-echomem-memory-workspace
ECHOMEM_ROOT=/absolute/path/to/EchoMem-repository
ECHOMEM_ACCOUNT=default
ECHOMEM_USER_ID=default
ECHOMEM_AGENT_ID=default

# Optional explicit paths. When omitted, eval.py discovers both files under
# ECHOMEM_WORKSPACE and reads credentials without copying them into this repo.
# ECHOMEM_CONFIG=/absolute/path/to/echomem-workspace/config.json
# ECHOMEM_AUTH_FILE=/absolute/path/to/echomem-workspace/.echomem_http_auth_keys.json
# ECHOMEM_AUTH_KEY=

# Let ./eval.sh start EchoMem with ECHOMEM_WORKSPACE when ECHOMEM_BASE_URL is offline.
# The managed service is stopped when evaluation exits unless --keep-echomem is used.
ECHOMEM_AUTO_START=1
# ECHOMEM_START_TIMEOUT_S=180

# LoCoMo is bundled at benchmarks/locomo/data/locomo10.json.
# Set LOCOMO_DATASET only to override it with a custom copy.
# LOCOMO_DATASET=/absolute/path/to/custom-locomo10.json
# Other dataset locations remain required when those benchmarks are selected.
HOTPOTQA_DATASET=/absolute/path/to/hotpot_dev_distractor_v1.json
LONGMEMEVAL_DATASET=/absolute/path/to/longmemeval_s_cleaned.json

# Answer model. These values take precedence over EchoMem's config.json.
# If omitted, eval.py falls back to model.llm in ECHOMEM_CONFIG.
# ANSWER_BASE_URL=https://provider.example.com/compatible-mode/v1
# ANSWER_MODEL=your-answer-model
# ANSWER_TOKEN=

# Optional separate judge model. Defaults to the answer model.
# JUDGE_BASE_URL=https://provider.example.com/compatible-mode/v1
# JUDGE_MODEL=your-judge-model
# JUDGE_TOKEN=
