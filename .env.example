BENCHMARK_CONSOLE_API_BASE=http://127.0.0.1:19181
BENCHMARK_CONSOLE_V2_HOST=127.0.0.1
BENCHMARK_CONSOLE_V2_PORT=4173

# EchoMemory HTTP black-box service.
ECHOMEM_BASE_URL=http://127.0.0.1:18080
# Optional. Leave empty when the EchoMemory auth bootstrap endpoints are enabled.
ECHOMEM_AUTH_KEY=

# EchoMemory's own extraction and retrieval models. Use credentials and model
# names from your own provider for formal accuracy runs.
ECHOMEM_LLM_API_BASE=https://provider.example.com/compatible-mode/v1
ECHOMEM_LLM_MODEL=your-llm-model
ECHOMEM_LLM_API_KEY=
ECHOMEM_EMBEDDING_API_BASE=https://provider.example.com/compatible-mode/v1
ECHOMEM_EMBEDDING_MODEL=your-embedding-model
ECHOMEM_EMBEDDING_API_KEY=
ECHOMEM_EMBEDDING_DIMENSIONS=1024

# Local harness inputs and client state. The dataset is not bundled.
LOCOMO_DATASET=/absolute/path/to/locomo10.json
LOCOMO_CLIENT_STATE=/absolute/path/to/locomo-conv30-client-state
LOCOMO_ACCOUNT=locomo-conv30
LOCOMO_USER_ID=default
LOCOMO_AGENT_ID=default

# OpenAI-compatible answer and judge providers used by the harness. These are
# separate roles even when they share EchoMemory's LLM endpoint.
ANSWER_BASE_URL=https://provider.example.com/compatible-mode/v1
ANSWER_MODEL=your-answer-model
ANSWER_TOKEN=
# Default: send enable_thinking=false. Set provider_default only for an
# explicitly labeled thinking-mode ablation.
ANSWER_THINKING_MODE=disabled
JUDGE_BASE_URL=https://provider.example.com/compatible-mode/v1
JUDGE_MODEL=your-judge-model
JUDGE_TOKEN=
