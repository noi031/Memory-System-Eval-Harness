{
  "faults": [
    {
      "kind": "llm-500",
      "endpoint": "http://127.0.0.1:8010/admin/faults",
      "action": "llm_500"
    },
    {
      "kind": "vector-down",
      "command": "/usr/local/bin/echomem-test-control vector-down --duration-s 30"
    },
    {
      "kind": "llm-vector-faults",
      "command": "/usr/local/bin/echomem-test-control llm-500-and-hang --duration-s 30"
    }
  ],
  "recovery": {
    "health_url": "http://127.0.0.1:8010/health",
    "container": "echomem",
    "restart_command": "docker start echomem",
    "wait_s": 120,
    "poll_s": 2
  },
  "cursor": {
    "url_template": "http://127.0.0.1:8010/api/sessions/{session}/cursor?archive_id={archive}"
  }
}
